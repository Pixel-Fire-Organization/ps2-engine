{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Engine ECS Schema",
  "type": "object",
  "required": ["components", "entities"],
  "properties": {
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "properties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type"],
              "properties": {
                "name": { "type": "string" },
                "type": { 
                  "type": "string",
                  "enum": ["int", "float", "bool", "string", "choices", "flags", "color255"]
                },
                "description": { "type": "string" },
                "default": { "type": ["string", "number", "boolean"] },
                "options": {
                  "type": "object",
                  "additionalProperties": { "type": "string" },
                  "description": "Used only for 'choices' and 'flags' to map integers to names."
                }
              }
            }
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "engineHook"],
              "properties": {
                "name": { "type": "string" },
                "engineHook": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["classname", "description", "components"],
        "properties": {
          "classname": { "type": "string" },
          "classType": { 
            "type": "string",
            "enum": ["PointClass", "SolidClass"],
            "default": "PointClass"
          },
          "description": { "type": "string" },
          "components": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
{
  "$schema": "./schema.json",
  "components": [
    {
      "name": "HealthComponent",
      "description": "Handles entity vitality",
      "properties": [
        { "name": "max_health", "type": "int", "description": "Maximum health", "default": 100 }
      ],
      "actions": [
        { "name": "hurtPlayer", "engineHook": "HurtEntity" }
      ]
    },
    {
      "name": "CollisionComponent",
      "description": "Handles physics layers",
      "properties": [
        {
          "name": "layer_mask",
          "type": "flags",
          "description": "Collision layers this entity interacts with",
          "default": 1,
          "options": {
            "1": "WORLD",
            "2": "PLAYER",
            "4": "ENEMY"
          }
        }
      ]
    },
    {
      "name": "ModelComponent",
      "description": "Handles 3D mesh rendering",
      "properties": [
        { 
          "name": "model", 
          "type": "studio", 
          "description": "Path to the 3D model file", 
          "default": "models/barrel.mdl" 
        }
      ]
    }
  ],
  "entities": [
    {
      "classname": "prop_barrel",
      "classType": "PointClass",
      "description": "An explosive barrel",
      "components": ["HealthComponent", "CollisionComponent", "ModelComponent"]
    },
    {
      "classname": "prop_model",
      "classType": "PointClass",
      "description": "An static model",
      "components": ["CollisionComponent", "ModelComponent"]
    }
  ]
}